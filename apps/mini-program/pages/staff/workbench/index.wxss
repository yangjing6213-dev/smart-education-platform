.staff-page {
  padding-top: 24rpx;
}

.staff-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  gap: 20rpx;
  margin-bottom: 42rpx;
}

.eyebrow {
  display: block;
  color: #6b61df;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  color: #17213b;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.synthetic-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #5a4bc3;
  background: #f0eeff;
  font-size: 20rpx;
  font-weight: 700;
}

.status-announcement {
  margin-bottom: 20rpx;
  color: #65708b;
  font-size: 22rpx;
}

.staff-list {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 18rpx;
}

.staff-card,
.state-card {
  min-width: 0;
  padding: 30rpx;
  border: 2rpx solid #e5e8f3;
  border-radius: 24rpx 8rpx 24rpx 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(25, 35, 75, 0.06);
}

.staff-card-label {
  display: block;
  color: #6b61df;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.staff-card-title {
  display: block;
  margin-top: 18rpx;
  color: #17213b;
  font-size: 31rpx;
  font-weight: 700;
}

.staff-card-copy {
  display: block;
  margin-top: 10rpx;
  color: #65708b;
  font-size: 23rpx;
  line-height: 1.6;
}

.state-card-error {
  border-color: #f2d6d6;
  background: #fff8f8;
}

.state-title {
  display: block;
  color: #17213b;
  font-size: 29rpx;
  font-weight: 700;
}

.muted-copy {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
}

.primary-button {
  width: 100%;
  margin-top: 28rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #273bce;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.primary-button::after {
  border: 0;
}

.secondary-button {
  width: 100%;
  margin-top: 16rpx;
  border: 2rpx solid #dfe3f0;
  border-radius: 999rpx;
  color: #273bce;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.secondary-button::after {
  border: 0;
}

.footer-note {
  display: block;
  margin-top: 58rpx;
  color: #9098ad;
  font-size: 20rpx;
  text-align: center;
}
