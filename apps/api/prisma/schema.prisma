model FeeDocument {
  tenantId              String                  @map("tenant_id") @db.Uuid
  campusId              String                  @map("campus_id") @db.Uuid
  id                    String                  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId             String                  @map("student_id") @db.Uuid
  documentType          FeeDocumentType         @map("document_type")
  title                 String                  @db.VarChar(120)
  period                String                  @db.VarChar(7)
  amountMinor           BigInt?                 @map("amount_minor")
  currency              String                  @default("CNY") @db.VarChar(3)
  validFrom             DateTime                @map("valid_from") @db.Date
  validTo               DateTime                @map("valid_to") @db.Date
  status                FeeDocumentStatus       @default(AVAILABLE)
  summary               String                  @db.VarChar(500)
  version               Int                     @default(1)
  createdByMembershipId String                  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  campus                Campus                  @relation("FeeDocumentCampus", fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "fee_documents_campus_fkey")
  student               Student                 @relation("FeeDocumentStudent", fields: [tenantId, campusId, studentId], references: [tenantId, campusId, id], onDelete: Restrict, onUpdate: Cascade, map: "fee_documents_student_fkey")
  createdBy             MembershipCampus        @relation("FeeDocumentCreator", fields: [tenantId, createdByMembershipId, campusId], references: [tenantId, membershipId, campusId], onDelete: Restrict, onUpdate: Cascade, map: "fee_documents_creator_fkey")
  ledgerEntries         FeeLedgerEntry[]        @relation("FeeLedgerDocument")
  auditEvents           FeeDocumentAuditEvent[] @relation("FeeDocumentAuditDocument")

  @@id([tenantId, campusId, id])
  @@index([tenantId, campusId, studentId, status, createdAt(sort: Desc)], map: "fee_documents_scope_student_status_created_idx")
  @@map("fee_documents")
}

