model Tenant {
  id                                  String                               @id @default(uuid()) @db.Uuid
  name                                String
  slug                                String
  status                              String
  createdAt                           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  campuses                            Campus[]                             @relation("TenantCampuses")
  memberships                         Membership[]                         @relation("TenantMemberships")
  institutionContentRecords           InstitutionContentRecord[]           @relation("InstitutionContentRecordTenant")
  institutionContentPublicationEvents InstitutionContentPublicationEvent[] @relation("InstitutionContentPublicationEventTenant")
  userProfileChangeRequests           UserProfileChangeRequest[]           @relation("UserProfileChangeRequestTenant")

  @@index([slug])
  @@map("tenants")
}

model Campus {
  staffLibraryItems StaffLibraryItem[]
  tenantId                            String                               @map("tenant_id") @db.Uuid
  id                                  String                               @default(uuid()) @db.Uuid
  name                                String
  status                              String
  publicProfileRef                    String?                              @map("public_profile_ref")
  createdAt                           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                              Tenant                               @relation("TenantCampuses", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membershipScopes                    MembershipCampus[]
  students                            Student[]
  mealPlans                           MealPlan[]                           @relation("MealPlanCampus")
  mealPublicationEvents               MealPublicationEvent[]               @relation("MealPublicationEventCampus")
  bindingApplications                 BindingApplication[]                 @relation("BindingApplicationCampus")
  guardianRelationships               GuardianRelationship[]               @relation("GuardianRelationshipCampus")
  guardianRelationshipAuditEvents     GuardianRelationshipAuditEvent[]     @relation("GuardianRelationshipAuditEventCampus")
  guardianConsents                    GuardianConsent[]                    @relation("GuardianConsentCampus")
  parentLearningSessions              ParentLearningSession[]              @relation("ParentLearningSessionCampus")
  workTasks                           WorkTask[]                           @relation("WorkTaskCampus")
  pickupExceptions                    PickupException[]                    @relation("PickupExceptionCampus")
  staffDailyReports                   StaffDailyReport[]                   @relation("StaffDailyReportCampus")
  monthlyFeedbackReports              MonthlyFeedbackReport[]              @relation("MonthlyFeedbackCampus")
  childMonthlyReports                 ChildMonthlyReport[]                 @relation("ChildMonthlyCampus")
  aiInstitutionSetting                AIInstitutionSetting?                @relation("AIInstitutionSettingCampus")
  notices                             Notice[]                             @relation("NoticeCampus")
  parentLearningSummaries             ParentLearningSummarySnapshot[]      @relation("ParentLearningSummaryCampus")
  parentLearningControls              ParentLearningControl[]              @relation("ParentLearningControlCampus")
  parentLearningContactIntents        ParentLearningContactIntent[]        @relation("ParentLearningContactIntentCampus")
  feeDocuments                        FeeDocument[]                        @relation("FeeDocumentCampus")
  feeLedgerEntries                    FeeLedgerEntry[]                     @relation("FeeLedgerCampus")
  feeDocumentAuditEvents              FeeDocumentAuditEvent[]              @relation("FeeDocumentAuditCampus")
  institutionContentRecords           InstitutionContentRecord[]           @relation("InstitutionContentRecordCampus")
  institutionContentPublicationEvents InstitutionContentPublicationEvent[] @relation("InstitutionContentPublicationEventCampus")

  @@id([tenantId, id])
  @@index([tenantId, status])
  @@index([publicProfileRef])
  @@map("campuses")
}

model InstitutionContentRecord {
  id                String                               @id @default(uuid()) @db.Uuid
  tenantId          String                               @map("tenant_id") @db.Uuid
  campusId          String?                              @map("campus_id") @db.Uuid
  contentKey        String                               @map("content_key") @db.VarChar(128)
  contentType       String                               @map("content_type") @db.VarChar(32)
  status            String                               @db.VarChar(16)
  title             String                               @db.VarChar(160)
  version           Int                                  @default(1)
  visibility        String                               @db.VarChar(16)
  body              Json                                 @db.JsonB
  publishedAt       DateTime?                            @map("published_at") @db.Timestamptz(6)
  syntheticData     Boolean                              @default(true) @map("synthetic_data")
  editorNote        String                               @default("") @map("editor_note") @db.VarChar(2000)
  moderationState   String                               @default("UNREVIEWED") @map("moderation_state") @db.VarChar(32)
  tenantAdminNote   String                               @default("") @map("tenant_admin_note") @db.VarChar(2000)
  campusAdminNote   String                               @default("") @map("campus_admin_note") @db.VarChar(2000)
  updatedBy         String                               @map("updated_by") @db.VarChar(128)
  updatedAt         DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                               @relation("InstitutionContentRecordTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "institution_content_records_tenant_id_fkey")
  campus            Campus?                              @relation("InstitutionContentRecordCampus", fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "institution_content_records_tenant_id_campus_id_fkey")
  publicationEvents InstitutionContentPublicationEvent[] @relation("InstitutionContentPublicationEventContent")

  @@unique([tenantId, id])
  @@index([tenantId, campusId, contentKey], map: "institution_content_records_scope_key_idx")
  @@index([tenantId, campusId, contentType, status, publishedAt(sort: Desc)], map: "institution_content_records_scope_type_status_published_idx")
  @@map("institution_content_records")
}

model InstitutionContentPublicationEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  campusId         String?                  @map("campus_id") @db.Uuid
  contentId        String                   @map("content_id") @db.Uuid
  contentKey       String                   @map("content_key") @db.VarChar(128)
  action           String                   @db.VarChar(16)
  resultingVersion Int                      @map("resulting_version")
  actorReference   String                   @map("actor_reference") @db.VarChar(128)
  occurredAt       DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz(6)
  tenant           Tenant                   @relation("InstitutionContentPublicationEventTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "institution_content_publication_events_tenant_id_fkey")
  campus           Campus?                  @relation("InstitutionContentPublicationEventCampus", fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "institution_content_publication_events_tenant_id_campus_id_fkey")
  content          InstitutionContentRecord @relation("InstitutionContentPublicationEventContent", fields: [tenantId, contentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "institution_content_publication_events_tenant_id_content_id_fke")

  @@index([tenantId, campusId, occurredAt(sort: Desc)], map: "institution_content_publication_events_scope_time_idx")
  @@index([tenantId, contentId, occurredAt(sort: Desc)], map: "institution_content_publication_events_content_time_idx")
  @@map("institution_content_publication_events")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  status                 String
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships            Membership[]
  inviteAuthSessions     InviteAuthSession[]
  bindingApplications    BindingApplication[]    @relation("BindingApplicationApplicant")
  guardianRelationships  GuardianRelationship[]  @relation("GuardianRelationshipGuardian")
  guardianConsents       GuardianConsent[]       @relation("GuardianConsentGuardian")
  parentLearningSessions ParentLearningSession[] @relation("ParentLearningSessionGuardian")
  leaveRequests          LeaveRequest[]          @relation("LeaveRequestRequester")
  noticeReceipts         NoticeReceipt[]         @relation("NoticeReceiptGuardian")
  childMonthlyEvents     ChildMonthlyEvent[]     @relation("ChildMonthlyActor")
  transfersRequested     StudentTransferRequest[] @relation("TransferRequesterUser")
  transfersReviewed      StudentTransferRequest[] @relation("TransferReviewerUser")
  transferAuditEvents    StudentTransferAuditEvent[] @relation("TransferAuditUser")
  inviteAuthAccount      InviteAuthAccount?
  identitySecurityEvents IdentitySecurityEvent[]
  profileChangeRequests  UserProfileChangeRequest[] @relation("ProfileChangeApplicant")
  reviewedProfileChanges UserProfileChangeRequest[] @relation("ProfileChangeReviewer")

  @@map("users")
}

model InviteAuthSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("invite_auth_sessions")
}

model InviteAuthAccount {
  userId             String    @id @map("user_id") @db.Uuid
  username           String    @db.VarChar(64)
  normalizedUsername String    @unique @map("normalized_username") @db.VarChar(64)
  passwordHash       String    @map("password_hash") @db.VarChar(256)
  displayName        String    @map("display_name") @db.VarChar(80)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("invite_auth_accounts")
}

model IdentitySecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(48)
  outcome   String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, eventType, createdAt(sort: Desc)], map: "identity_security_events_user_type_time_idx")
  @@map("identity_security_events")
}

model UserProfileChangeRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  requestedDisplayName String    @map("requested_display_name") @db.VarChar(80)
  status               String    @default("PENDING") @db.VarChar(16)
  version              Int       @default(1)
  reviewerUserId       String?   @map("reviewer_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(6)
  user                 User      @relation("ProfileChangeApplicant", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant               Tenant    @relation("UserProfileChangeRequestTenant", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewer             User?     @relation("ProfileChangeReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, status, createdAt], map: "user_profile_change_requests_scope_status_time_idx")
  @@index([userId, createdAt(sort: Desc)], map: "user_profile_change_requests_user_time_idx")
  @@map("user_profile_change_requests")
}

model Membership {
  tenantId  String             @map("tenant_id") @db.Uuid
  id        String             @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  status    MembershipStatus
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant             @relation("TenantMemberships", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campuses  MembershipCampus[]

  @@id([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@map("memberships")
}

model MembershipCampus {
  staffLibraryActivity StaffLibraryActivity[]
  tenantId                        String                           @map("tenant_id") @db.Uuid
  membershipId                    String                           @map("membership_id") @db.Uuid
  campusId                        String                           @map("campus_id") @db.Uuid
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  membership                      Membership                       @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  campus                          Campus                           @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  careRecordsCreated              CareRecord[]                     @relation("CareRecordCreator")
  careRecordsReviewed             CareRecord[]                     @relation("CareRecordReviewer")
  careRecordsUpdated              CareRecord[]                     @relation("CareRecordUpdater")
  careRecordRevisionsReviewed     CareRecordRevision[]             @relation("CareRevisionReviewer")
  careRecordRevisionsUpdated      CareRecordRevision[]             @relation("CareRevisionUpdater")
  attendanceRecordsRecorded       AttendanceRecord[]               @relation("AttendanceRecorder")
  attendanceRecordsUpdated        AttendanceRecord[]               @relation("AttendanceUpdater")
  attendanceRevisionsUpdated      AttendanceRecordRevision[]       @relation("AttendanceRevisionUpdater")
  attendanceCorrectionsRequested  AttendanceCorrection[]           @relation("AttendanceCorrectionRequester")
  attendanceCorrectionsReviewed   AttendanceCorrection[]           @relation("AttendanceCorrectionReviewer")
  mealPlansUpdated                MealPlan[]                       @relation("MealPlanUpdater")
  mealPublicationEvents           MealPublicationEvent[]           @relation("MealPublicationEventActor")
  bindingApplicationsReviewed     BindingApplication[]             @relation("BindingApplicationReviewer")
  guardianRelationshipsApproved   GuardianRelationship[]           @relation("GuardianRelationshipApprover")
  guardianRelationshipAuditEvents GuardianRelationshipAuditEvent[] @relation("GuardianRelationshipAuditEventActor")
  leaveRequestsUpdated            LeaveRequest[]                   @relation("LeaveRequestUpdater")
