{
  "name": "@student-care/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./openapi/v1.json": {
      "types": "./openapi/v1.json",
      "import": "./openapi/v1.json",
      "default": "./openapi/v1.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/test/schema.test.js dist/test/identity.test.js",
    "build": "tsc -p tsconfig.json"
  }
}
