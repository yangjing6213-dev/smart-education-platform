.env.*

# Phase 1A 批次B批准的只读视觉输入；不得提交或进入审查包
/phase-inputs/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
secrets*.json

# JavaScript 依赖与缓存
node_modules/
.npm/
.pnpm-store/
.yarn/
.next/
dist/
build/

# Python 环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 仅忽略项目根的 Playwright 输出；artifacts/ 下批准的同名证据故意不忽略
/playwright-report/
/test-results/
/blob-report/
/.cache/ms-playwright/

# 编辑器、项目根日志与系统垃圾；artifacts/**/*.log 故意不忽略
